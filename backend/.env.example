# ===================================
# 🔐 Database Configuration
# ===================================
# Para desarrollo local, usar credenciales PostgreSQL locales
# Para Render.com, DATABASE_URL se proporciona automáticamente

# Opción 1: URL de conexión (recomendado para producción/Render)
DATABASE_URL=postgresql://username:password@host:5432/bd_tienda

# Opción 2: Credenciales separadas (para desarrollo local)
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=bd_tienda
DB_PORT=5432

# ===================================
# 🔑 Security & Authentication
# ===================================
JWT_SECRET=your_random_secret_key_here_minimum_32_chars

# ===================================
# 🌐 Frontend Configuration
# ===================================
FRONTEND_URL=http://localhost:5173

# ===================================
# 🚀 Server Configuration
# ===================================
NODE_ENV=development
PORT=3000
